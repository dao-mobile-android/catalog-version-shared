{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // extends: ['config:best-practices'],
  schedule: [
    'at any time'
  ],
  constraints: {
    java: '21',
  },
  timezone: 'America/Sao_Paulo',
  dependencyDashboard: true,
  dependencyDashboardTitle: 'Renovate — Dependencies Panel (AGP)',
  semanticCommits: 'enabled',
  packageRules: [
    {
      matchPackageNames: [
        '*'
      ],
      enabled: false,
    },
    {
      // Android Gradle Plugin (AGP)
      matchDepNames: [
        'com.android.tools.build:gradle',
      ],
      matchPackageNames: [
        'com.android.tools.build:gradle',
        'com.android.dynamic-feature**',
        'com.android.application**',
        'com.android.library**',
        'com.android.test**',
      ],
      groupName: 'Android Gradle Plugin (AGP)',
      groupSlug: 'android-plugins',
      commitMessageTopic: 'Android Gradle Plugin (AGP)',
      branchTopic: 'android-plugins',
      matchUpdateTypes: [
        'major',
        'minor',
        'patch'
      ],
      automergeType: 'squash',
      enabled: true,
    },
    {
      matchManagers: [
        'gradle-wrapper'
      ],
      groupName: 'Gradle',
      automergeType: 'squash',
      automerge: true
    },
    {
      // GitHub Actions (Major, Minor, Patch)
      matchManagers: [
        'github-actions'
      ],
      groupName: 'GitHub Actions',
      automergeType: 'squash',
      automerge: true,
    }
  ],
  platformAutomerge: true,
  recreateWhen: 'always',
  ignoreTests: true,
  automerge: true
}
