{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  schedule: [
    'at any time',
  ],
  timezone: 'America/Sao_Paulo',
  packageRules: [
    {
      matchManagers: [
        'gradle',
      ],
      matchDepNames: [
        'com.android.tools.build:gradle',
        'com.android.dynamic-feature',
        'com.android.application',
        'com.android.library',
        'com.android.test',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
      ],
      groupName: 'Android Gradle Plugin (AGP)',
      groupSlug: 'android-plugins',
      commitMessageTopic: 'Android Gradle Plugin (AGP)',
      branchTopic: 'android-plugins',
      enabled: true,
    },
  ],
  dependencyDashboardTitle: 'Renovate — Dependencies Panel (AGP)',
  dependencyDashboard: true,
  semanticCommits: 'enabled',
  platformAutomerge: true,
  recreateWhen: 'always',
  automergeType: 'pr',
  automerge: true,
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
}