{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // extends: ['config:best-practices'],
  schedule: ['at any time'],
  constraints: {
    java: '21',
  },
  timezone: 'America/Sao_Paulo',
  dependencyDashboard: true,
  dependencyDashboardTitle: 'Renovate — Dependencies Panel (AGP)',
  semanticCommits: 'enabled',
  packageRules: [
    // 1. Regra Global: Desativa a atualização de qualquer dependência por padrão
    {
      matchPackageNames: ['*'],
      enabled: false,
    },
    // 2. Lista de Permissões: Reativa explicitamente apenas os pacotes do AGP
    {
      matchDepNames: [
        'com.android.tools.build:gradle',
      ],
      matchPackageNames: [
        'com.android.tools.build:gradle',
        'com.android.dynamic-feature**',
        'com.android.application**',
        'com.android.library**',
        'com.android.test**',
      ],
      enabled: true,
      ignoreUnstable: false,
//      matchUpdateTypes: ['major', 'minor', 'patch'],
      groupName: 'Android Gradle Plugin (AGP)',
      groupSlug: 'android-plugins',
      commitMessageTopic: 'Android Gradle Plugin (AGP)',
      branchTopic: 'android-plugins',

      automerge: true,
      recreateWhen: 'always',
      automergeType: 'squash',
      platformAutomerge: true,
      requiredStatusChecks: null,
    },
  ]
}

